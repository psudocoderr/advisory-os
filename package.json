{
  "name": "advisory-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:sim": "vitest run -c vitest.simulation.config.mts",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:migrations": "tsx tests/migrations/run.ts",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:migrate": "node scripts/with-env.mjs --local-only prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs --writes prisma migrate deploy",
    "db:status": "node scripts/with-env.mjs prisma migrate status",
    "db:drift": "node scripts/with-env.mjs node scripts/check-drift.mjs",
    "db:push": "node scripts/with-env.mjs --local-only node scripts/guard-push.mjs",
    "db:seed": "node scripts/with-env.mjs --writes tsx prisma/seed.ts",
    "db:snapshot": "node scripts/with-env.mjs tsx scripts/snapshot.ts",
    "db:reseed": "npm run db:snapshot && npm run db:seed",
    "questions:check": "node scripts/with-env.mjs tsx scripts/questions.ts check",
    "questions:template": "node scripts/with-env.mjs tsx scripts/questions.ts template",
    "questions:import": "node scripts/with-env.mjs --writes tsx scripts/questions.ts import",
    "bootstrap:admin": "node scripts/with-env.mjs --writes tsx scripts/bootstrap-admin.ts",
    "db:studio": "node scripts/with-env.mjs --writes prisma studio",
    "db:validate": "node scripts/with-env.mjs prisma validate"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild": false,
    "prisma": false,
    "unrs-resolver": false,
    "@prisma/client": false,
    "@prisma/engines": false
  }
}
