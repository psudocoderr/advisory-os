# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/
credentials/

# Next.js
.next/
out/
build/
dist/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma/local databases
prisma/generated/
*.db
*.db-journal
*.sqlite
# Keeps stray dumps out of the repo. Migrations are the deliberate exception:
# they ARE the schema's source of truth and must be committed and reviewed.
*.sql
!prisma/migrations/**/*.sql
*.dump
backups/

# Testing and logs
coverage/
test-results/
playwright-report/
logs/
*.log

# OS/editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/settings.json
*.swp
*.swo

# Authoring scratch: generated template and filled-in question files
questions-template.csv
questions-*.csv

# Misc
.cache/
tmp/
temp/
.turbo/
tsconfig.tsbuildinfo

# Internal working docs (confidential, not shipped product docs).
# docs/engineering/ and docs/legal/ are the committed counterparts: engineering
# reference and legal source text that must be reviewable in pull requests.
# Everything else here (PRD, memos, the parked WealthOS PDFs) stays local.
docs/*
!docs/engineering/
!docs/legal/
