generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, :6543 on Supabase) — used by the running application.
  url       = env("DATABASE_URL")
  // Session mode (:5432) — required by migrate; the pooler cannot serve it.
  // Every env() here must be set wherever any prisma command runs, including
  // `prisma validate`, which resolves them eagerly.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ADVISOR
}

enum ProspectSource {
  REFERRAL
  WALK_IN
  EVENT
  ONLINE
}

enum ProspectStage {
  LEAD
  MEETING_HELD
  PLAN_SENT
  ONBOARDED
  DROPPED
}

enum KycStatus {
  VERIFIED
  PENDING
  EXPIRED
}

enum MeetingKind {
  PROSPECT
  CLIENT
  PLAN
  REVIEW
}

enum PlanType {
  SIP
  LUMP_SUM
  ELSS
  MIXED
}

enum PlanFrequency {
  MONTHLY
  QUARTERLY
  ONE_TIME
}

enum PlanGoal {
  RETIREMENT
  EDUCATION
  WEALTH
  TAX_SAVING
  OTHER
}

enum PlanStatus {
  DRAFT
  SENT
  ACCEPTED
  ACTIVE
  CLOSED
}

enum ModuleCode {
  M1
  M2
  M3
  M4
  M5
}

enum TestSessionStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
  /// Ended by the system for repeated integrity violations. Distinct from
  /// FAILED (sat the test and did not reach the standard) and from ABANDONED
  /// (walked away), because conflating them would misreport what happened.
  TERMINATED
}

enum IntegrityEventKind {
  DEVTOOLS_ATTEMPT
  FULLSCREEN_EXIT
  FULLSCREEN_ENTER
  TAB_HIDDEN
  WINDOW_BLUR
  COPY
  PASTE
  CONTEXT_MENU
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Level on a module badge or track certificate. Replaces the free-text
/// `Certification.level`, whose "Foundation" band is renamed Satisfactory.
enum BadgeLevel {
  SATISFACTORY
  PROFICIENT
  EXPERT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADVISOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedProspects  Prospect[]          @relation("ProspectAssignment")
  assignedClients    Client[]            @relation("ClientAssignment")
  meetings           MeetingLog[]        @relation("MeetingOwner")
  auditLogs          AuditLog[]          @relation("AuditActor")
  questions          QuestionItem[]      @relation("QuestionAuthor")
  testSessions       TestSession[]
  certifications     Certification[]
  chapterCompletions ChapterCompletion[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

model Prospect {
  id               String         @id @default(cuid())
  name             String
  /// E.164, e.g. +919876543210. Shape enforced by a CHECK constraint.
  phone            String         @unique @db.VarChar(16)
  source           ProspectSource
  firstContactDate DateTime
  stage            ProspectStage  @default(LEAD)
  notes            String
  followUpDate     DateTime?
  assignedToId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignedTo User         @relation("ProspectAssignment", fields: [assignedToId], references: [id])
  meetings   MeetingLog[] @relation("ProspectMeetings")

  @@index([stage])
  @@index([assignedToId])
  @@map("prospects")
}

model Client {
  id             String    @id @default(cuid())
  name           String
  /// E.164, e.g. +919876543210. Shape enforced by a CHECK constraint.
  phone          String    @unique @db.VarChar(16)
  /// Uppercase, ABCDE1234F. Shape enforced by a CHECK constraint.
  pan            String    @unique @db.Char(10)
  kycStatus      KycStatus @default(PENDING)
  aum            Decimal   @db.Decimal(18, 2)
  onboardingDate DateTime
  assignedToId   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo       User              @relation("ClientAssignment", fields: [assignedToId], references: [id])
  meetings         MeetingLog[]      @relation("ClientMeetings")
  investmentPlans  InvestmentPlan[]
  portfolioReviews PortfolioReview[]

  @@index([kycStatus])
  @@index([assignedToId])
  @@map("clients")
}

model MeetingLog {
  id           String      @id @default(cuid())
  kind         MeetingKind
  summary      String
  notes        String
  meetingDate  DateTime    @default(now())
  followUpDate DateTime?
  ownerId      String
  prospectId   String?
  clientId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner    User      @relation("MeetingOwner", fields: [ownerId], references: [id])
  prospect Prospect? @relation("ProspectMeetings", fields: [prospectId], references: [id], onDelete: Cascade)
  client   Client?   @relation("ClientMeetings", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([meetingDate])
  @@index([ownerId])
  @@map("meeting_logs")
}

model InvestmentPlan {
  id           String        @id @default(cuid())
  clientId     String
  planType     PlanType
  amount       Decimal       @db.Decimal(18, 2)
  frequency    PlanFrequency
  goal         PlanGoal
  status       PlanStatus    @default(DRAFT)
  sentDate     DateTime?
  acceptedDate DateTime?
  notes        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("investment_plans")
}

model PortfolioReview {
  id             String   @id @default(cuid())
  clientId       String
  reviewDate     DateTime
  currentAum     Decimal  @db.Decimal(18, 2)
  returns        Decimal  @db.Decimal(8, 2)
  actions        String
  nextReviewDate DateTime
  attachmentNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([nextReviewDate])
  @@map("portfolio_reviews")
}

/// A learning path, e.g. Operational-Excellence. Modules, chapters and tests
/// all hang off a track, so a second track is a new row, not a migration.
model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  order       Int      @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules        Module[]
  testSessions   TestSession[]
  certifications Certification[]

  @@map("tracks")
}

/// A unit within a track, completed in order and closed by an adaptive test
/// that awards a badge. Replaces the fixed ModuleCode enum (M1-M5).
model Module {
  id          String   @id @default(cuid())
  trackId     String
  slug        String
  title       String
  description String   @default("")
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track          Track           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  chapters       Chapter[]
  questions      QuestionItem[]
  testSessions   TestSession[]
  certifications Certification[]

  @@unique([trackId, order])
  @@unique([trackId, slug])
  @@map("modules")
}

/// One reading unit. `body` is markdown, rendered with raw HTML disabled.
model Chapter {
  id          String   @id @default(cuid())
  moduleId    String
  slug        String
  title       String
  body        String   @default("")
  order       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module              @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  completions ChapterCompletion[]
  questions   QuestionItem[]

  @@unique([moduleId, order])
  @@unique([moduleId, slug])
  @@map("chapters")
}

/// A trainee marked a chapter complete: the tick on the chapter.
model ChapterCompletion {
  userId      String
  chapterId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@map("chapter_completions")
}

model KnowledgeCategory {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries SopEntry[]

  @@unique([order])
  @@map("knowledge_categories")
}

model SopEntry {
  id           String      @id @default(cuid())
  categoryId   String
  module       ModuleCode?
  title        String
  slug         String      @unique
  what         String
  when         String
  steps        Json
  outcomes     Json
  commonErrors Json
  references   Json
  isPublished  Boolean     @default(true)
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  category  KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions QuestionItem[]

  @@index([module])
  @@map("sop_entries")
}

model QuestionItem {
  id             String      @id @default(cuid())
  /// Legacy, replaced by moduleId. Nullable so new code need not write it;
  /// dropped in the contract release.
  module         ModuleCode?
  moduleId       String?
  chapterId      String?
  content        String
  options        Json
  correctKey     String
  explanation    String
  difficulty     Float       @default(0)
  discrimination Float       @default(1)
  guessing       Float       @default(0.25)
  /// Legacy, replaced by chapterId. Dropped in the contract release.
  linkedSopId    String?
  createdById    String
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  linkedSop      SopEntry?     @relation(fields: [linkedSopId], references: [id], onDelete: Restrict)
  trainingModule Module?       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  chapter        Chapter?      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("QuestionAuthor", fields: [createdById], references: [id])
  responses      ResponseLog[]

  @@index([module])
  @@index([moduleId])
  @@map("question_items")
}

model TestSession {
  id              String            @id @default(cuid())
  userId          String
  /// Legacy, replaced by moduleId. Nullable so new code need not write it;
  /// dropped in the contract release.
  module          ModuleCode?
  trackId         String?
  /// Null on a final exam, which covers the whole track.
  moduleId        String?
  startedAt       DateTime          @default(now())
  /// When the first question was released and the clock started. Null until
  /// the candidate has entered fullscreen: time spent getting there is not
  /// time spent answering. The deadline is measured from this, not startedAt.
  timerStartedAt  DateTime?
  completedAt     DateTime?
  abilityEstimate Float             @default(0)
  standardError   Float             @default(99)
  certified       Boolean           @default(false)
  attemptNumber   Int               @default(1)
  status          TestSessionStatus @default(IN_PROGRESS)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           Track?           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  trainingModule  Module?          @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  responses       ResponseLog[]
  certification   Certification?
  integrityEvents IntegrityEvent[]

  @@index([userId, module])
  @@index([userId, moduleId])
  @@map("test_sessions")
}

model ResponseLog {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  selectedKey    String
  isCorrect      Boolean
  responseTimeMs Int
  abilityAfter   Float
  seAfter        Float
  createdAt      DateTime @default(now())

  session  TestSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question QuestionItem @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@map("response_logs")
}

/// Records that a candidate left the exam surface during a test: exited
/// fullscreen, switched tab, blurred the window, copied or pasted.
///
/// Deliberately a record, not a control. No browser API can prevent a
/// screenshot, a phone camera or a second device, so this does not pretend to
/// stop anything. It exists so a reviewer can see what happened and when.
model IntegrityEvent {
  id         String             @id @default(cuid())
  sessionId  String
  kind       IntegrityEventKind
  occurredAt DateTime           @default(now())

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@map("integrity_events")
}

/// A module badge (moduleId set) or a track certificate (moduleId null).
model Certification {
  id             String              @id @default(cuid())
  userId         String
  /// Legacy, replaced by moduleId. Dropped in the contract release.
  module         ModuleCode?
  trackId        String?
  moduleId       String?
  sessionId      String              @unique
  abilityScore   Float
  /// Share of answers correct in the deciding session, 0-100. Each level has
  /// a floor on it as well as on theta.
  percentCorrect Float?
  badgeLevel     BadgeLevel?
  /// Legacy free-text level, replaced by badgeLevel. Dropped in the contract release.
  level          String?
  issuedAt       DateTime            @default(now())
  /// Legacy. Badges no longer expire. Dropped in the contract release.
  expiresAt      DateTime?
  status         CertificationStatus @default(ACTIVE)

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        TestSession @relation(fields: [sessionId], references: [id])
  track          Track?      @relation(fields: [trackId], references: [id], onDelete: Restrict)
  trainingModule Module?     @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([userId, module, status])
  @@unique([userId, moduleId, status])
  @@map("certifications")
}
