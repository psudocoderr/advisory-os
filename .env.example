# Copy to .env.local and fill in real values. Never commit real credentials.

# --- Database ---------------------------------------------------------------
# Two URLs are required, and the difference matters.
#
#   DATABASE_URL  Pooled connection, used by the running application.
#                 On Supabase this is the pgbouncer pooler on port 6543 with
#                 ?pgbouncer=true. Transaction mode: fine for queries, cannot
#                 run migrations or hold a shadow database.
#
#   DIRECT_URL    Session-mode connection on port 5432. Used by prisma migrate
#                 and prisma db push. Required by prisma/schema.prisma.
#
# Pointing migrations at the pooler is what broke login before commit 43f7e37.
DATABASE_URL="postgresql://advisory_app:advisory_app_password@localhost:5432/advisory_os?schema=public"
DIRECT_URL="postgresql://advisory_app:advisory_app_password@localhost:5432/advisory_os?schema=public"


# --- Auth -------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- Seed -------------------------------------------------------------------
# The seed deletes every row before inserting. It refuses to run against a
# deployed database; set ALLOW_DESTRUCTIVE_SEED=1 only if you genuinely mean
# to wipe one. See docs/engineering/runbook.md.
SEED_ADMIN_EMAIL="admin@advisory.local"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
SEED_ADVISOR_EMAIL="advisor@advisory.local"
SEED_ADVISOR_PASSWORD="ChangeMeAdvisor123!"

# --- Compliance operations --------------------------------------------------
# Published on the legal pages. IT Rules 2021 requires a named grievance
# officer with a reachable contact, acknowledging complaints within 24 hours.
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_EMAIL=""

# Shared secret for scheduled jobs (retention sweep, review reminders).
# Cron routes reject requests without a matching bearer token.
CRON_SECRET=""

# --- Post-MVP hardening hooks (not read by any code yet) --------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""
REDIS_URL=""
DB_ENCRYPTION_KEY=""
IP_ALLOWLIST=""
